diff --git a/src/runtime/proc.go b/src/runtime/proc.go
index b8d4d15..da997e7 100644
--- a/src/runtime/proc.go
+++ b/src/runtime/proc.go
@@ -6544,10 +6544,15 @@ func sysmon() {
 	lasttrace := int64(0)
 	idle := 0 // how many cycles in succession we had not wokeup somebody
 	delay := uint32(0)
+	// gVisor patch: GODEBUG=sysmonmindelay=N raises the shortest sleep
+	// below from 20us to N us (at most 10ms). Programs whose goroutines
+	// frequently wake up from blocking syscalls otherwise keep sysmon
+	// polling every 20us, at a cost of thousands of wakeups per second.
+	minDelay := uint32(min(max(debug.sysmonmindelay, 20), 10*1000))
 
 	for {
 		if idle == 0 { // start with 20us sleep...
-			delay = 20
+			delay = minDelay
 		} else if idle > 50 { // start doubling the sleep after 1ms...
 			delay *= 2
 		}
@@ -6600,7 +6605,7 @@ func sysmon() {
 				}
 				if syscallWake {
 					idle = 0
-					delay = 20
+					delay = minDelay
 				}
 			}
 			unlock(&sched.lock)
